{
  "name": "filtre-ia",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "description": "Anonymisation locale de prompts avant envoi à une IA",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:single": "npm run build && tsx scripts/build-single.ts",
    "e2e": "tsx scripts/e2e.ts",
    "demo": "tsx scripts/demo.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "check": "npm run lint && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
